# Supabase - DB, Auth ו-Storage
# אלה בדיוק 4 הערכים שמקבלים מ-Supabase (Project Settings → API).
# ה-URL וה-Publishable key הם "ציבוריים" - מותר שיגיעו לדפדפן, ולכן
# מקבלים קידומת NEXT_PUBLIC_. ה-Secret key וה-JWKS URL נשארים בצד שרת בלבד.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# מפתח סודי - שרת בלבד! לעולם לא NEXT_PUBLIC_, לעולם לא בקוד שנשלח לדפדפן.
SUPABASE_SECRET_KEY=
# כתובת לאימות טוקנים (JWT) בצד שרת בלי לפנות ל-Supabase בכל בקשה - שימושי
# ב-middleware.ts. גם היא נשארת כמשתנה server-only.
SUPABASE_JWKS_URL=

# OAuth - התחברות עם GitHub (מוגדר גם בצד Supabase Auth וגם כאן לצורך דחיפת קומיטים)
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=

# OAuth - התחברות עם Google (מוגדר בצד Supabase Auth)
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# AI (Gemini): כל משתמש מביא מפתח משלו - בפרופיל (מוצפן בשרת) או "בדפדפן בלבד".
# אין מפתח מערכת. אופציונלי: עקיפת רשימת המודלים (מופרדים בפסיקים, לפי עדיפות) -
# כשגוגל משנה שמות מודלים משנים כאן ועושים Redeploy, בלי שינוי קוד.
# ברירת המחדל ב-lib/ai/models.ts. ציבורי בכוונה (גם הדפדפן פונה ל-Gemini) - אין בו סוד.
NEXT_PUBLIC_GEMINI_MODELS=

# מפתח הצפנה לשמירת מפתחות API אישיים של משתמשים ב-DB (AES-256-GCM).
# חייב להיות base64 של 32 בתים בדיוק: openssl rand -base64 32
# אסור להחליף/למחוק אחרי שנשמרו מפתחות (הם לא יפוענחו). משמש גם ל-hash של IP בהגבלת קצב.
KEYS_ENCRYPTION_SECRET=

# כתובת האתר הציבורית (למשל https://weblok.example.com) - משמשת לתגיות המטא (SEO),
# ל-sitemap ולקרדיט שנכנס לקוד המיוצא. ב-Vercel אפשר להשאיר ריק: נלקח אוטומטית
# מהדומיין הראשי של הפרויקט.
# SEO: Search Console מאומת בקובץ public/google*.html (לא בתגית meta ולא במשתנה סביבה).
# דיפלוי Preview של Vercel מסומן noindex אוטומטית (VERCEL_ENV, לא צריך להגדיר כלום).
NEXT_PUBLIC_SITE_URL=
